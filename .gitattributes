# Files left out of the archives Git builds (git archive), which Composer
# installs from: the package holds the library, its README, its license and
# its changelog, not the demo, the tests, the API docs or the tools of the
# repository.
/.drove.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/bin export-ignore
/demo export-ignore
/demo-sso export-ignore
/docs export-ignore
/phpunit.xml.dist export-ignore
/tests export-ignore
