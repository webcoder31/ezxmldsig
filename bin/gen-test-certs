#!/bin/sh
#
# Generates the X.509 certificates and keys used by the test suite and by the
# demo.
#
# Usage:
#   bin/gen-test-certs              writes tests/fixtures/certs/
#   bin/gen-test-certs --demo       writes demo/certs/
#   bin/gen-test-certs --demo-sso   writes demo-sso/certs/
#
# tests/fixtures/certs/ receives:
#   root.cert.pem, root.key.pem                  root CA (self-signed)
#   intermediate.cert.pem, intermediate.key.pem  intermediate CA, issued by root
#   sign.cert.pem, sign.key.pem                  signing certificate, issued by
#                                                the intermediate; key protected
#                                                by the password "signKeyPassword"
#   crypt.cert.pem, crypt.key.pem                encryption certificate, issued by
#                                                the intermediate; key unprotected
#   attacker.cert.pem, attacker.key.pem          certificate signed by its own key,
#                                                whose subject and issuer DN copy
#                                                those of sign.cert.pem
#   future.cert.pem, future.key.pem              signing certificate issued by the
#                                                intermediate, valid in 2099 only:
#                                                not yet valid, both its dates
#                                                written as GeneralizedTime
#   long.cert.pem, long.key.pem                  signing certificate issued by the
#                                                intermediate, valid from 2026 to
#                                                2060: its end date is written as
#                                                GeneralizedTime (from 2050 on)
#
# demo/certs/ receives the files the demo uses: root.cert.pem and
# intermediate.cert.pem (the trust anchor of the demo receiver),
# sign.cert.pem, sign.key.pem (password "signKeyPassword"), crypt.cert.pem and
# crypt.key.pem (password "cryptKeyPassword"), attacker.cert.pem and
# attacker.key.pem (as above), and the certificates of the attacks of the
# demo:
#   rogue-root.cert.pem                          root CA that the demo does not
#                                                trust (self-signed)
#   rogue.cert.pem, rogue.key.pem                signing certificate issued by
#                                                rogue-root.cert.pem, whose
#                                                subject DN copies that of
#                                                sign.cert.pem
#   ec.cert.pem                                  certificate with an EC key
#                                                (P-256) signed by its own key,
#                                                whose subject DN copies that of
#                                                sign.cert.pem (its key is not
#                                                kept)
#
# demo-sso/certs/ receives the encryption certificates of the two
# applications of the single sign-on demo, each signed by its own key (the
# library does not verify the chain of an encryption certificate), with keys
# that have no password:
#   mail.crypt.cert.pem, mail.crypt.key.pem
#   crm.crypt.cert.pem, crm.crypt.key.pem
# The other files of the single sign-on demo come from demo/certs/.
#
# Every certificate is valid for 10 years from the time of generation, but
# future.cert.pem and long.cert.pem, which have fixed dates.
#
# The script always runs itself again inside an Alpine Docker container
# (alpine:3.22), whatever openssl the host has: the certificates then come
# from the same OpenSSL version on every machine (the host may have LibreSSL,
# or an OpenSSL whose behavior differs). The container runs as root, to
# install openssl, and gives the written files back to the calling user.

set -eu

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)

MODE=tests
case "${1:-}" in
    "") ;;
    --demo) MODE=demo ;;
    --demo-sso) MODE=demo-sso ;;
    *) echo "Usage: $0 [--demo | --demo-sso]" >&2; exit 2 ;;
esac

if [ "${GEN_CERTS_IN_DOCKER:-}" != 1 ]; then
    if ! docker info >/dev/null 2>&1; then
        echo "Docker is not reachable (with Colima: colima start)." >&2
        exit 1
    fi
    echo "Running in Docker (alpine:3.22)." >&2
    exec docker run --rm -e GEN_CERTS_IN_DOCKER=1 \
        -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
        -v "$ROOT_DIR:/work" -w /work \
        --entrypoint sh alpine:3.22 -c \
        'apk add --no-cache -q openssl >/dev/null && sh bin/gen-test-certs "$@"' \
        sh "$@"
fi

if ! openssl version 2>/dev/null | grep -q '^OpenSSL'; then
    echo "OpenSSL is not available in the container." >&2
    exit 1
fi

if [ "$MODE" = demo ]; then
    OUT_DIR="$ROOT_DIR/demo/certs"
    CRYPT_KEY_PASSWORD=cryptKeyPassword
elif [ "$MODE" = demo-sso ]; then
    OUT_DIR="$ROOT_DIR/demo-sso/certs"
    CRYPT_KEY_PASSWORD=
else
    OUT_DIR="$ROOT_DIR/tests/fixtures/certs"
    CRYPT_KEY_PASSWORD=
fi
SIGN_KEY_PASSWORD=signKeyPassword
DAYS=3650

# Distinguished names. The demo receiver expects the organization and the
# organizational unit of SIGN_DN (see demo/src/Certs.php).
ROOT_DN="/C=DK/ST=Jylland/L=Kattegat/O=Lothbrok Ltd/OU=Jarl Dept/CN=www.lothbrok.dk/emailAddress=ragnar@lothbrok.dk"
INTERMEDIATE_DN="/C=DK/ST=Jylland/O=Lothbrok Ltd/OU=Shield Wall Dept/CN=www.lothbrok.dk/emailAddress=ivar@lothbrok.dk"
SIGN_DN="/C=DK/ST=Jylland/L=Kattegat/O=Lothbrok Ltd/OU=Signature Dept/CN=www.lothbrok.dk/emailAddress=ivar@lothbrok.dk"
CRYPT_DN="/C=DK/ST=Jylland/L=Kattegat/O=Lothbrok Ltd/OU=Cryptography Dept/CN=www.lothbrok.dk/emailAddress=ivar@lothbrok.dk"
ROGUE_ROOT_DN="/C=DK/O=Kattegat Trust Services/CN=Kattegat Root CA"

WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT

cat > "$WORK_DIR/ext.cnf" <<'EOF'
[root]
basicConstraints = critical, CA:TRUE
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash

[intermediate]
basicConstraints = critical, CA:TRUE, pathlen:0
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[sign]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, nonRepudiation
extendedKeyUsage = clientAuth, emailProtection
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[ec]
basicConstraints = CA:FALSE
keyUsage = critical, digitalSignature, nonRepudiation
subjectKeyIdentifier = hash

[crypt]
basicConstraints = CA:FALSE
keyUsage = critical, keyEncipherment, dataEncipherment
extendedKeyUsage = clientAuth, emailProtection
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
EOF

# genkey <file> <bits> [password]
genkey() {
    if [ -n "${3:-}" ]; then
        openssl genpkey -algorithm RSA -pkeyopt "rsa_keygen_bits:$2" \
            -aes-256-cbc -pass "pass:$3" -out "$1" 2>/dev/null
    else
        openssl genpkey -algorithm RSA -pkeyopt "rsa_keygen_bits:$2" \
            -out "$1" 2>/dev/null
    fi
}

# issue <name> <subject DN> <extension section> <CA cert> <CA key> [key password]
# Signs a CSR for $WORK_DIR/<name>.key.pem with the given CA.
issue() {
    openssl req -new -key "$WORK_DIR/$1.key.pem" -passin "pass:${6:-}" \
        -subj "$2" -out "$WORK_DIR/$1.csr"
    openssl x509 -req -in "$WORK_DIR/$1.csr" -sha256 -days "$DAYS" \
        -CA "$4" -CAkey "$5" -set_serial "0x$(openssl rand -hex 16)" \
        -extfile "$WORK_DIR/ext.cnf" -extensions "$3" \
        -out "$WORK_DIR/$1.cert.pem" 2>/dev/null
}

# issue_dated <name> <subject DN> <extension section> <CA cert> <CA key>
#             <not before> <not after>
# Same as issue, with fixed dates (YYYYMMDDHHMMSSZ).
issue_dated() {
    openssl req -new -key "$WORK_DIR/$1.key.pem" \
        -subj "$2" -out "$WORK_DIR/$1.csr"
    openssl x509 -req -in "$WORK_DIR/$1.csr" -sha256 \
        -not_before "$6" -not_after "$7" \
        -CA "$4" -CAkey "$5" -set_serial "0x$(openssl rand -hex 16)" \
        -extfile "$WORK_DIR/ext.cnf" -extensions "$3" \
        -out "$WORK_DIR/$1.cert.pem" 2>/dev/null
}

# Single sign-on demo: one encryption certificate per application.
if [ "$MODE" = demo-sso ]; then
    FILES=
    for app in mail crm; do
        genkey "$WORK_DIR/$app.crypt.key.pem" 2048
        openssl req -new -x509 -sha256 -days "$DAYS" \
            -key "$WORK_DIR/$app.crypt.key.pem" \
            -subj "/C=DK/O=Lothbrok Ltd/OU=Cryptography Dept/CN=$app.localhost" \
            -set_serial "0x$(openssl rand -hex 16)" \
            -config "$WORK_DIR/ext.cnf" -extensions crypt \
            -out "$WORK_DIR/$app.crypt.cert.pem" 2>/dev/null
        FILES="$FILES $app.crypt.cert.pem $app.crypt.key.pem"
    done
    mkdir -p "$OUT_DIR"
    for f in $FILES; do
        cp "$WORK_DIR/$f" "$OUT_DIR/$f"
        chown "$HOST_UID:$HOST_GID" "$OUT_DIR/$f"
    done
    echo "Certificates written to ${OUT_DIR#$ROOT_DIR/}:"
    for f in $FILES; do
        echo "  $f"
    done
    exit 0
fi

# Root CA.
genkey "$WORK_DIR/root.key.pem" 4096
openssl req -new -x509 -sha256 -days "$DAYS" -key "$WORK_DIR/root.key.pem" \
    -subj "$ROOT_DN" -set_serial "0x$(openssl rand -hex 16)" \
    -config "$WORK_DIR/ext.cnf" -extensions root \
    -out "$WORK_DIR/root.cert.pem" 2>/dev/null

# Intermediate CA, issued by the root.
genkey "$WORK_DIR/intermediate.key.pem" 4096
issue intermediate "$INTERMEDIATE_DN" intermediate \
    "$WORK_DIR/root.cert.pem" "$WORK_DIR/root.key.pem"

# Signing and encryption certificates, issued by the intermediate.
genkey "$WORK_DIR/sign.key.pem" 2048 "$SIGN_KEY_PASSWORD"
issue sign "$SIGN_DN" sign \
    "$WORK_DIR/intermediate.cert.pem" "$WORK_DIR/intermediate.key.pem" \
    "$SIGN_KEY_PASSWORD"
genkey "$WORK_DIR/crypt.key.pem" 2048 "$CRYPT_KEY_PASSWORD"
issue crypt "$CRYPT_DN" crypt \
    "$WORK_DIR/intermediate.cert.pem" "$WORK_DIR/intermediate.key.pem" \
    "$CRYPT_KEY_PASSWORD"

# Attacker certificate: signed by its own key, with the subject DN of the
# signing certificate and the DN of the intermediate as issuer. A throwaway CA
# certificate carrying the intermediate DN and the attacker key provides the
# issuer name.
genkey "$WORK_DIR/attacker.key.pem" 2048
openssl req -new -x509 -sha256 -days "$DAYS" -key "$WORK_DIR/attacker.key.pem" \
    -subj "$INTERMEDIATE_DN" -config "$WORK_DIR/ext.cnf" -extensions intermediate \
    -out "$WORK_DIR/attacker-issuer.cert.pem" 2>/dev/null
issue attacker "$SIGN_DN" sign \
    "$WORK_DIR/attacker-issuer.cert.pem" "$WORK_DIR/attacker.key.pem"

if [ "$MODE" = tests ]; then
    # Signing certificates with dates from 2050 on, which X.509 writes as
    # GeneralizedTime (4-digit year) instead of UTCTime.
    genkey "$WORK_DIR/future.key.pem" 2048
    issue_dated future "$SIGN_DN" sign \
        "$WORK_DIR/intermediate.cert.pem" "$WORK_DIR/intermediate.key.pem" \
        20990101000000Z 20991231235959Z
    genkey "$WORK_DIR/long.key.pem" 2048
    issue_dated long "$SIGN_DN" sign \
        "$WORK_DIR/intermediate.cert.pem" "$WORK_DIR/intermediate.key.pem" \
        20260101000000Z 20600101000000Z
fi

if [ "$MODE" = demo ]; then
    # Untrusted root CA, and a signing certificate it issued with the subject
    # DN of the signing certificate.
    genkey "$WORK_DIR/rogue-root.key.pem" 2048
    openssl req -new -x509 -sha256 -days "$DAYS" \
        -key "$WORK_DIR/rogue-root.key.pem" \
        -subj "$ROGUE_ROOT_DN" -set_serial "0x$(openssl rand -hex 16)" \
        -config "$WORK_DIR/ext.cnf" -extensions root \
        -out "$WORK_DIR/rogue-root.cert.pem" 2>/dev/null
    genkey "$WORK_DIR/rogue.key.pem" 2048
    issue rogue "$SIGN_DN" sign \
        "$WORK_DIR/rogue-root.cert.pem" "$WORK_DIR/rogue-root.key.pem"
    openssl verify -CAfile "$WORK_DIR/rogue-root.cert.pem" \
        "$WORK_DIR/rogue.cert.pem" >/dev/null

    # Certificate with an EC key, signed by its own key.
    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 \
        -out "$WORK_DIR/ec.key.pem" 2>/dev/null
    openssl req -new -x509 -sha256 -days "$DAYS" -key "$WORK_DIR/ec.key.pem" \
        -subj "$SIGN_DN" -set_serial "0x$(openssl rand -hex 16)" \
        -config "$WORK_DIR/ext.cnf" -extensions ec \
        -out "$WORK_DIR/ec.cert.pem" 2>/dev/null
fi

# Consistency checks.
openssl verify -CAfile "$WORK_DIR/root.cert.pem" \
    "$WORK_DIR/intermediate.cert.pem" >/dev/null
for name in sign crypt; do
    openssl verify -CAfile "$WORK_DIR/root.cert.pem" \
        -untrusted "$WORK_DIR/intermediate.cert.pem" \
        "$WORK_DIR/$name.cert.pem" >/dev/null
done

if [ "$MODE" = demo ]; then
    FILES="root.cert.pem intermediate.cert.pem sign.cert.pem sign.key.pem
           crypt.cert.pem crypt.key.pem attacker.cert.pem attacker.key.pem
           rogue-root.cert.pem rogue.cert.pem rogue.key.pem ec.cert.pem"
else
    FILES="root.cert.pem root.key.pem intermediate.cert.pem intermediate.key.pem
           sign.cert.pem sign.key.pem crypt.cert.pem crypt.key.pem
           attacker.cert.pem attacker.key.pem future.cert.pem future.key.pem
           long.cert.pem long.key.pem"
fi

mkdir -p "$OUT_DIR"
for f in $FILES; do
    cp "$WORK_DIR/$f" "$OUT_DIR/$f"
    chown "$HOST_UID:$HOST_GID" "$OUT_DIR/$f"
done
echo "Certificates written to ${OUT_DIR#$ROOT_DIR/}:"
for f in $FILES; do
    echo "  $f"
done
