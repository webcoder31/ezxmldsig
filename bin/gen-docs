#!/bin/sh
#
# Generates the API documentation of src/ into docs/, in Docker.
#
# Usage:
#   bin/gen-docs
#
# docs/ is the source of the GitHub Pages site of the project (branch master,
# folder /docs): its home page is docs/index.html. It only holds generated
# files: it is replaced as a whole, so that the pages of removed classes or
# methods do not remain.
#
# The documentation is generated by ApiGen, in its official image
# apigen/apigen pinned below by digest, from the docblocks of the public and
# protected members (the constructor documents the options). Its pages load
# their style sheet and scripts from docs/assets/ only. ApiGen also writes a
# page for each class of PHP or of xmlseclibs the code refers to, which it
# reads from vendor/: when vendor/ is missing, dependencies are installed
# first with `composer install`, in the composer:2 image, as bin/test does.
# Its cache stays in the container, and the paths it writes are relative to
# the repository.

set -eu

ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)

# ApiGen publishes no versioned image: the digest pins the image of the tag
# sha-aa151a961053d20e46d2c7da65cbb03c130d12ff (ApiGen dev-master).
APIGEN_IMAGE=apigen/apigen@sha256:76a7f5aa2091ebd38b15e9032e65ac63f9293d3c7fee530342535b21806a6b9d
TITLE=EZXMLDSIG
BUILD_DIR=tests/.cache/docs-build

case "${1:-}" in
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    '') ;;
    *) echo "Usage: $0" >&2; exit 2 ;;
esac

if ! docker info >/dev/null 2>&1; then
    echo "Docker is not reachable (with Colima: colima start)." >&2
    exit 1
fi

DOCKER_USER="$(id -u):$(id -g)"

# Dependencies.
if [ ! -f "$ROOT_DIR/vendor/autoload.php" ]; then
    echo "vendor/ is missing: running composer install (composer:2 image)." >&2
    docker run --rm -u "$DOCKER_USER" -e COMPOSER_HOME=/tmp/composer \
        -e COMPOSER_NO_BLOCKING \
        -v "$ROOT_DIR:/app" -w /app composer:2 \
        install --no-interaction --no-progress --ignore-platform-reqs
fi

# The documentation is built in a temporary directory of the repository (the
# directory Docker can mount, tests/.cache/ being ignored by git), then
# replaces docs/.
rm -rf "${ROOT_DIR:?}/$BUILD_DIR"
mkdir -p "$ROOT_DIR/tests/.cache"
trap 'rm -rf "${ROOT_DIR:?}/$BUILD_DIR"' EXIT

# One worker: with several, the order of the lists of subclasses changes
# from one run to the next.
docker run --rm -u "$DOCKER_USER" \
    -v "$ROOT_DIR:/data" -w /data "$APIGEN_IMAGE" \
    --no-interaction \
    --workers 1 \
    --title "$TITLE" \
    --temp /tmp/apigen \
    --output "$BUILD_DIR" \
    src

if [ ! -f "$ROOT_DIR/$BUILD_DIR/index.html" ]; then
    echo "ApiGen wrote no $BUILD_DIR/index.html: docs/ left unchanged." >&2
    exit 1
fi

# No path of this machine or of the container may be published.
if grep -rlF -e "$ROOT_DIR" -e "/data/" -e "/src/vendor/" "$ROOT_DIR/$BUILD_DIR" >&2; then
    echo "The generated files above hold an absolute path: docs/ left unchanged." >&2
    exit 1
fi

rm -rf "${ROOT_DIR:?}/docs"
mv "$ROOT_DIR/$BUILD_DIR" "$ROOT_DIR/docs"
echo "API documentation written to docs/ (home page: docs/index.html)."
